{
  "name": "lifestyle-tracker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @lifestyle/web --",
    "build": "npm run build -w @lifestyle/web",
    "preview": "npm run preview -w @lifestyle/web --",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc -b apps/web packages/shared && tsc --noEmit -p apps/api",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "shots": "node scripts/screenshot.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run smoke && scripts/killport.sh --orphans",
    "api": "npm run dev -w @lifestyle/api",
    "twophone": "node scripts/twophone.mjs",
    "phase3": "node scripts/phase3test.mjs",
    "invite": "node scripts/invite.mjs",
    "tour": "node scripts/tour.mjs",
    "purge-trash": "node scripts/purge-trash.mjs"
  },
  "devDependencies": {
    "oxlint": "^1.79.0",
    "playwright": "^1.62.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  }
}
